<div class="kitten_info">
  <h1>New Kitten</h1>

  <%= form_with model: @kitten do |f| %>
  
    <div>
      <%= f.label :name, "Name:" %>
      <%= f.text_field :name %>
    </div>
    <div>
      <%= f.label :age, "Age:" %>
      <%= f.number_field :age %>
    </div>
    <div>
      <%= f.label :cuteness, "Cuteness:" %>
      <%= f.number_field :cuteness %>
    </div>
    <div>
      <%= f.label :softness, "Softness:" %>
      <%= f.number_field :softness %>
    </div>
    <div>
      <%= f.submit "Create Kitten" %>
  <% end %>
  
  <%= link_to "Home", root_path %>
</div>
